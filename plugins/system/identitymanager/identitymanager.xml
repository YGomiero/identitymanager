<?xml version='1.0' encoding='utf-8'?>
<extension type="plugin" group="system" method="upgrade">
  <name>plg_system_identitymanager</name>
  <author>Yann Gomiero</author>
  <creationDate>2026-10</creationDate>
  <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
  <version>1.0.0</version>
  <description>PLG_SYSTEM_IDENTITYMANAGER_XML_DESCRIPTION</description>
  <namespace path="src">Yann\Plugin\System\IdentityManager</namespace>
  <files>
    <folder plugin="identitymanager">services</folder>
    <folder>src</folder>
    <filename>LICENSE.txt</filename>
    <folder>language</folder>
  </files>
  <languages>
    <language tag="en-GB">language/en-GB/plg_system_identitymanager.ini</language>
    <language tag="en-GB">language/en-GB/plg_system_identitymanager.sys.ini</language>
    <language tag="fr-FR">language/fr-FR/plg_system_identitymanager.ini</language>
    <language tag="fr-FR">language/fr-FR/plg_system_identitymanager.sys.ini</language>
  </languages>
  <config>
    <fields name="params">
      <fieldset name="basic">
        <field name="inject_buttons" type="radio" layout="joomla.form.field.radio.switcher" label="PLG_SYSTEM_IDENTITYMANAGER_INJECT" default="1" filter="integer">
          <option value="0">JNO</option>
          <option value="1">JYES</option>
        </field>
      </fieldset>
    </fields>
  </config>
  <authorEmail>extensions@gomiero.me</authorEmail>
  <authorUrl>https://github.com/YGomiero/identitymanager-joomla</authorUrl>
  <copyright>(C) 2026 Yann Gomiero</copyright>
</extension>